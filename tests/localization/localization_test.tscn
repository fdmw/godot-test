[ext_resource type="Resource" path="res://tests/localization/zh_CN.tres" id="2_zh"]
[ext_resource type="Resource" path="res://tests/localization/en.tres" id="3_en"]

[node name="LocalizationTest" type="Control"]
layout_mode = 3
